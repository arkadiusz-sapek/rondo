{
  "name": "rondo-workspace",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter rondo-server --filter rondo-client dev",
    "dev:server": "pnpm --filter rondo-server dev",
    "dev:client": "pnpm --filter rondo-client dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "db:up": "docker compose up -d db",
    "db:push": "pnpm --filter rondo-server db:push"
  },
  "packageManager": "pnpm@11.1.3"
}
